# Looma Attendance: send /admin and /api/... to index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(data|includes|lib|seed)(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# never let anyone download the config or data files
<FilesMatch "^(config\.php|config\.sample\.php)$">
  Require all denied
</FilesMatch>
