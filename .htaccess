Options -Indexes
# Block direct access to internal files
<FilesMatch "^(config\.php|config\.sample\.php|README\.md|\.git.*)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 80M
</IfModule>

# Don't inherit WordPress rewrite rules from the main site, and never cache app pages in LiteSpeed.
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>
# Versioned CSS/JS (?v=...) can be cached by browsers.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
