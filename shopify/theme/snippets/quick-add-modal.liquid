<dialog class="quick-add" id="QuickAdd" data-quick-add-modal aria-label="{{ 'products.product.quick_add' | t }}">
  <button type="button" class="popup__close" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
  <div class="quick-add__body" data-quick-add-body>
    <div class="quick-add__loading">{{ 'general.loading' | t }}</div>
  </div>
</dialog>
