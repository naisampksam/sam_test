{%- comment -%}
  Star rating. Uses the standard reviews metafields written by review apps
  (Judge.me, Loox, Shopify Product Reviews...). Renders nothing without data.
  Accepts: product, show_count (boolean)
{%- endcomment -%}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if rating != blank and count > 0 -%}
  {%- assign value = rating.rating | times: 1.0 -%}
  {%- assign scale = rating.scale_max | default: 5 | times: 1.0 -%}
  {%- assign pct = value | divided_by: scale | times: 100 | round -%}
  <div class="stars" title="{{ value | round: 1 }} / {{ scale | round }}">
    <span class="stars__icons" style="--rating: {{ pct }}%;" aria-hidden="true">★★★★★</span>
    <span class="stars__value">{{ value | round: 1 }}</span>
    {%- if show_count -%}<span class="stars__count">({{ count }})</span>{%- endif -%}
    <span class="visually-hidden">{{ 'products.product.rating' | t: rating: value, count: count }}</span>
  </div>
{%- endif -%}
