{%- comment -%}
  English meaning for Japanese text used across the theme.
  Accepts: text. Write "漢字|English" in any kanji setting to set your own translation.
{%- endcomment -%}
{%- liquid
  assign jp = text | strip
  if jp contains '|'
    echo jp | split: '|' | last | strip
  else
    case jp
      when 'よくある質問'
        echo 'FAQ'
      when '質問'
        echo 'Questions'
      when '道場'
        echo 'Dojo'
      when '誠'
        echo 'Honesty'
      when '義'
        echo 'Rectitude'
      when '礼'
        echo 'Respect'
      when '忠義'
        echo 'Loyalty'
      when '名誉'
        echo 'Honour'
      when '勇'
        echo 'Courage'
      when '仁'
        echo 'Compassion'
      when '配送'
        echo 'Shipping'
      when '特価'
        echo 'Special offers'
      when '物語'
        echo 'Our story'
      when '武士道'
        echo 'The way of the warrior'
      when '寸法'
        echo 'Size guide'
      when '交換'
        echo 'Exchanges'
      when 'お客様の声'
        echo 'Reviews'
      when '違い'
        echo 'The difference'
      when '連絡'
        echo 'Contact'
      when '追跡'
        echo 'Tracking'
      when '迷子'
        echo 'Lost'
      when '最近見た'
        echo 'Recently viewed'
      when '新作'
        echo 'New drops'
      when '品揃え'
        echo 'Collections'
      when '価格'
        echo 'Shop by price'
      when '仲間'
        echo 'The clan'
      when '人気'
        echo 'Bestsellers'
      when 'おすすめ'
        echo 'You may also like'
      when '俳句'
        echo 'Haiku'
      when '忍'
        echo 'Shinobi · Stealth'
      when '侍'
        echo 'Samurai'
      when '道'
        echo 'The way'
      when '話'
        echo 'Talk to us'
      when '換'
        echo 'Exchange'
      when '寸'
        echo 'Measure'
      when '問'
        echo 'Ask'
      when '浪人'
        echo 'Rōnin · Masterless warrior'
      when '鬼'
        echo 'Oni · Demon'
      when '七転び八起き'
        echo 'Fall seven times, rise eight'
      when '不動心'
        echo 'Unshakable mind'
      when '富士'
        echo 'Mt. Fuji'
      when '報'
        echo 'Reward'
      when '勝'
        echo 'Victory'
      when '斬'
        echo 'Slash'
      when '団体注文'
        echo 'Team orders'
      when '新作 · 武士道'
        echo 'New drop · Bushidō'
      when '東京'
        echo 'Tokyo'
      when '戦士'
        echo 'Warriors'
      when '心'
        echo 'Heart'
      when '力'
        echo 'Strength'
      when '夢'
        echo 'Dream'
      when '魂'
        echo 'Spirit'
      when '刀'
        echo 'Katana'
    endcase
  endif
-%}
