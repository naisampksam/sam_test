<section class="slideshow slideshow--{{ section.settings.height }}" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
  <div class="slideshow__track" data-slideshow-track>
    {%- for block in section.blocks -%}
      <div class="slideshow__slide" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank and block.settings.button_label == blank -%}
          <a href="{% render 'safe-url', url: block.settings.link %}" class="slideshow__link" aria-label="{{ block.settings.heading | escape }}"></a>
        {%- endif -%}
        <div class="slideshow__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              {{
                block.settings.image_mobile
                | image_url: width: 1200
                | image_tag:
                  class: 'slideshow__image slideshow__image--mobile',
                  widths: '600, 900, 1200',
                  sizes: '100vw',
                  loading: 'eager'
              }}
            {%- endif -%}
            {%- liquid
              assign image_class = 'slideshow__image'
              if block.settings.image_mobile != blank
                assign image_class = 'slideshow__image slideshow__image--desktop'
              endif
              assign loading = 'lazy'
              if forloop.first
                assign loading = 'eager'
              endif
            -%}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                class: image_class,
                widths: '750, 1100, 1500, 1800, 2400',
                sizes: '100vw',
                loading: loading
            }}
          {%- elsif block.settings.asset_image != blank -%}
            <img class="slideshow__image" src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.heading | escape }}" width="2400" height="1100"{% unless forloop.first %} loading="lazy"{% endunless %}>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <div class="slideshow__content slideshow__content--{{ block.settings.position }} slideshow__content--{{ block.settings.text_color }}">
          {%- if block.settings.subheading != blank -%}
            <p class="slideshow__subheading">{{ block.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="slideshow__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{% render 'safe-url', url: block.settings.link %}" class="button{% if block.settings.text_color == 'light' %} button--light{% endif %}">
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="slideshow__dot{% if forloop.first %} is-active{% endif %}"
          data-slide-to="{{ forloop.index0 }}"
          aria-label="{{ 'general.slide' | t: number: forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Slideshow",
  "tag": "div",
  "class": "section-slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "large"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "label": "Change slide every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 x 1200px recommended" },
        { "type": "text", "id": "asset_image", "label": "Fallback theme asset", "info": "File name from the theme's assets folder, used when no image is picked" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)", "info": "900 x 1200px recommended" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "New drop" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Oversized. Heavyweight. Everyday." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "position",
          "label": "Text position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text color",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide", "settings": { "asset_image": "hero-oversized.jpg" } },
        { "type": "slide", "settings": { "asset_image": "hero-acid-wash.jpg", "subheading": "Acid wash · 250 GSM", "heading": "Washed for that vintage feel" } }
      ]
    }
  ]
}
{% endschema %}
