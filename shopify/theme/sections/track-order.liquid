<section class="section page-width page-width--narrow track-order">
  <div class="track-order__card">
    {% render 'kanji-kicker', text: section.settings.kanji %}
    <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte track-order__text">{{ section.settings.text }}</div>{%- endif -%}
    <form class="track-order__form" data-track-order data-url="{{ section.settings.tracking_url | escape }}" target="_blank">
      <label for="TrackId-{{ section.id }}" class="visually-hidden">{{ section.settings.placeholder | escape }}</label>
      <input
        type="text"
        id="TrackId-{{ section.id }}"
        name="tracking"
        placeholder="{{ section.settings.placeholder | escape }}"
        autocomplete="off"
        required
      >
      <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
    </form>
    <p class="track-order__or">{{ section.settings.account_text | escape }}
      <a class="link-underline" href="{{ routes.account_url }}">{{ section.settings.account_link_label | escape }}</a>
    </p>
    {%- if section.settings.help_text != blank -%}
      <div class="track-order__help rte">{{ section.settings.help_text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Track order",
  "class": "section-track-order",
  "settings": [
    { "type": "text", "id": "kanji", "label": "Japanese subtitle (kanji)", "default": "追跡" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where is my order?" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Enter the AWB / tracking number from your shipping SMS, WhatsApp or email.</p>"
    },
    {
      "type": "text",
      "id": "tracking_url",
      "label": "Tracking page URL",
      "info": "__ID__ is replaced with what the customer types. Shiprocket: https://shiprocket.co/tracking/__ID__",
      "default": "https://shiprocket.co/tracking/__ID__"
    },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "AWB / tracking number" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Track" },
    { "type": "text", "id": "account_text", "label": "Account text", "default": "Have an account?" },
    { "type": "text", "id": "account_link_label", "label": "Account link label", "default": "See all your orders" },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help text",
      "default": "<p>Orders ship within 24–48 hours and arrive in 3–7 working days. Need help? Email support@haikufit.in or message us on WhatsApp with your order number.</p>"
    }
  ],
  "presets": [{ "name": "Track order" }]
}
{% endschema %}
