<section class="page-banner{% if section.settings.style == 'light' %} page-banner--light{% endif %}">
  {%- if section.settings.watermark != blank -%}
    <span class="page-banner__watermark" lang="ja" aria-hidden="true">{{ section.settings.watermark | escape }}</span>
  {%- endif -%}
  <div class="page-width page-banner__inner">
    {% render 'kanji-kicker', text: section.settings.kanji %}
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow page-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="page-banner__heading">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="page-banner__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page banner",
  "class": "section-page-banner",
  "settings": [
    { "type": "text", "id": "kanji", "label": "Japanese subtitle (kanji)", "default": "道" },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "watermark", "label": "Large background kanji", "default": "侍" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "ink", "label": "Ink (dark)" },
        { "value": "light", "label": "Rice paper (light)" }
      ],
      "default": "ink"
    }
  ],
  "presets": [{ "name": "Page banner" }]
}
{% endschema %}
