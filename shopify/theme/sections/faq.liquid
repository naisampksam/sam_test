<section class="section page-width page-width--narrow faq">
  <div class="section__header section__header--center">
    {% render 'kanji-kicker', text: section.settings.kanji %}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="faq__list">
    {%- for block in section.blocks -%}
      <details class="accordion" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question | escape }} {% render 'icon', icon: 'chevron' %}</summary>
        <div class="accordion__content rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
  {%- if section.settings.contact_text != blank -%}
    <p class="faq__contact muted">{{ section.settings.contact_text | escape }} <a href="{% render 'safe-url', url: section.settings.contact_link %}" class="link-underline">{{ 'faq.contact' | t }}</a></p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "max_blocks": 15,
  "settings": [
    {
      "type": "text",
      "id": "kanji",
      "label": "Japanese subtitle (kanji)",
      "info": "Shown small above the heading, e.g. 新作. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact text",
      "default": "Still have questions?"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is Cash on Delivery available?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes, COD is available across India.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How does the Buy 2 / Buy 3 offer work?",
            "answer": "<p>Add any 2 tees to get 10% off, any 3 to get 15% off, or 5+ to get 20% off. Mix and match colors, sizes and styles. The discount is applied automatically at checkout.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "<p>Yes, COD is available across India. Prepaid orders get an extra ₹50 off with code PREPAID50.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What size should I buy?",
            "answer": "<p>Our oversized tees are designed to be roomy. Take your regular size for a relaxed fit, or one size down for a closer fit. Check the size chart on each product page.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders are dispatched within 24–48 hours and delivered in 3–6 business days in most cities.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your return & exchange policy?",
            "answer": "<p>Easy 7-day exchange on unused products with tags intact. Custom printed items can't be returned unless damaged.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
