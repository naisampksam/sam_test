<article class="page-width page-width--narrow section">
  <p class="muted">{{ article.published_at | time_tag: format: 'date' }}</p>
  <h1 class="page-title">{{ article.title | escape }}</h1>
  {%- if article.image -%}
    <div class="article__image">
      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 800px, 100vw' }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a href="{{ blog.url }}" class="link-underline">&larr; {{ 'blogs.back' | t: title: blog.title }}</a></p>
</article>

{% schema %}
{
  "name": "Blog post",
  "class": "section-main-article"
}
{% endschema %}
