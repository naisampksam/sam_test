<section class="page-width section cart">
  <h1 class="page-title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    {% render 'offer-progress' %}

    <form action="{{ routes.cart_url }}" method="post" class="cart__form" id="CartForm">
      <div class="cart__layout">
        <ul class="cart__items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title }}
                {%- endif -%}
              </a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="muted">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- assign first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and first_char != '_' -%}
                    <p class="muted cart-item__property">
                      {{ property.first | escape }}:
                      {%- if property.last contains '/uploads/' -%}
                        <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}</a>
                      {%- else -%}
                        {{ property.last | escape }}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                {%- endfor -%}
                <div class="cart-item__price">
                  {{ item.final_price | money }}
                  {%- if item.original_price > item.final_price -%}
                    <s class="muted">{{ item.original_price | money }}</s>
                  {%- endif -%}
                </div>
                <div class="cart-item__actions">
                  <div class="quantity quantity--small" data-quantity>
                    <button type="button" class="quantity__button" data-qty-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">−</button>
                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      class="quantity__input"
                      aria-label="{{ 'products.product.quantity' | t }}"
                      data-cart-quantity
                    >
                    <button type="button" class="quantity__button" data-qty-plus aria-label="{{ 'products.product.quantity_increase' | t }}">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="link-underline muted">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <div class="cart-item__total">{{ item.final_line_price | money }}</div>
            </li>
          {%- endfor -%}
        </ul>

        <aside class="cart__summary">
          {%- if section.settings.show_note -%}
            <label class="field">
              <span class="field__label">{{ 'cart.note' | t }}</span>
              <textarea name="note" class="field__input" rows="3">{{ cart.note }}</textarea>
            </label>
          {%- endif -%}

          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart__discount">{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</p>
          {%- endfor -%}

          {%- liquid
            assign savings = 0
            for item in cart.items
              if item.variant.compare_at_price > item.variant.price
                assign line_saving = item.variant.compare_at_price | minus: item.variant.price | times: item.quantity
                assign savings = savings | plus: line_saving
              endif
            endfor
            assign savings = savings | plus: cart.total_discount
            assign savings_money = savings | money
          -%}
          {%- if savings > 0 -%}
            <p class="cart-drawer__savings">{{ 'cart.you_save' | t: amount: savings_money }}</p>
          {%- endif -%}
          <p class="cart__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </p>
          <p class="muted cart__taxes">{{ 'cart.taxes_shipping' | t }}</p>

          <noscript><button type="submit" name="update" class="button button--secondary button--full">{{ 'cart.update' | t }}</button></noscript>
          <button type="submit" name="checkout" class="button button--full button--checkout">{% render 'icon', icon: 'lock' %} {{ 'cart.checkout' | t }}</button>

          <ul class="trust-mini">
            <li>{% render 'icon', icon: 'lock' %} {{ 'trust.secure' | t }}</li>
            <li>{% render 'icon', icon: 'cash' %} {{ 'trust.cod' | t }}</li>
            <li>{% render 'icon', icon: 'return' %} {{ 'trust.returns' | t }}</li>
          </ul>
          {% render 'coupon-list' %}
          {%- if additional_checkout_buttons -%}
            <div class="cart__dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </aside>
      </div>
    </form>
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Enable order notes", "default": true }
  ]
}
{% endschema %}
