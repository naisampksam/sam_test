<footer class="footer">
  <div class="page-width footer__grid">
    <div class="footer__about">
      {%- if section.settings.show_logo -%}
        <a href="{{ routes.root_url }}" class="footer__logo">
          <img src="{{ 'logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="800" height="122" loading="lazy">
        </a>
      {%- else -%}
        <p class="footer__brand">{{ shop.name }}</p>
      {%- endif -%}
      {%- if section.settings.about != blank -%}
        <div class="rte">{{ section.settings.about }}</div>
      {%- endif -%}
      <ul class="footer__social">
        {%- assign networks = 'instagram,facebook,youtube,x' | split: ',' -%}
        {%- for network in networks -%}
          {%- assign key = 'social_' | append: network -%}
          {%- if settings[key] != blank -%}
            <li>
              <a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ network | capitalize }}">
                {% render 'icon', icon: network %}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div class="footer__block" {{ block.shopify_attributes }}>
            <p class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title | escape }}</p>
            <ul class="footer__links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | replace: 'Catalog', 'Shop All' | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'text' -%}
          <div class="footer__block" {{ block.shopify_attributes }}>
            <p class="footer__heading">{{ block.settings.heading | escape }}</p>
            <div class="rte">{{ block.settings.text }}</div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="page-width footer__bottom">
    <div class="footer__legal">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ 'footer.rights' | t }}</p>
      {%- if section.settings.company_name != blank -%}
        <p class="footer__company">
          {{ section.settings.company_prefix | escape }} <strong>{{ section.settings.company_name | escape }}</strong>
          {%- if section.settings.company_details != blank %}<span class="footer__company-details">{{ section.settings.company_details | escape }}</span>{% endif -%}
        </p>
      {%- endif -%}
    </div>
    {%- if section.settings.show_payment_icons -%}
      <ul class="footer__payments" aria-label="{{ 'footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "About text",
      "default": "<p>Japanese warrior-inspired oversized tees. Every design carries its own haiku.</p>"
    },
    { "type": "checkbox", "id": "show_logo", "label": "Show HAIKUFIT logo (white)", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "header", "content": "Company" },
    { "type": "text", "id": "company_prefix", "label": "Text before company name", "default": "A brand of" },
    { "type": "text", "id": "company_name", "label": "Registered company name", "default": "LOOMA APPARELS LLP" },
    {
      "type": "text",
      "id": "company_details",
      "label": "Company details (optional)",
      "info": "e.g. registered address, GSTIN or LLPIN"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mon–Sat, 10am–7pm<br>support@haikufit.in</p>" }
      ]
    }
  ]
}
{% endschema %}
