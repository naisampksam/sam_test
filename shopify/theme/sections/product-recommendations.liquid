{%- comment -%}
  Loaded with JS from the Product Recommendations API, so it only shows on product pages.
{%- endcomment -%}
<section
  class="section page-width product-recommendations"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
  style="--columns: {{ section.settings.limit }}; --columns-mobile: 2;"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section__header">
      {% render 'kanji-kicker', text: section.settings.kanji %}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    </div>
    <ul class="product-grid product-grid--slider">
      {%- for rec in recommendations.products -%}
        <li class="product-grid__item">{% render 'product-card', card_product: rec %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "kanji",
      "label": "Japanese subtitle (kanji)",
      "info": "Shown small above the heading, e.g. 新作. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Type",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "complementary",
          "label": "Complementary (set in Search & Discovery app)"
        }
      ],
      "default": "related"
    }
  ]
}
{% endschema %}
