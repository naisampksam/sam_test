{%- if section.settings.show_title or page.content != blank -%}
  <section class="page-width page-width--narrow section">
    {%- if section.settings.show_title -%}
      <h1 class="page-title">{{ page.title | escape }}</h1>
    {%- endif -%}
    <div class="rte">{{ page.content }}</div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "class": "section-main-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "info": "Turn off on designed pages that already have a banner. The page content still shows if you write any.",
      "default": true
    }
  ]
}
{% endschema %}
