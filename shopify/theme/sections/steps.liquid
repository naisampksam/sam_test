<section class="section page-width steps">
  {%- if section.settings.heading != blank -%}
    <div class="section__header section__header--center">
      {% render 'kanji-kicker', text: section.settings.kanji %}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="section__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  {%- endif -%}
  <ol class="steps__list" role="list">
    {%- for block in section.blocks -%}
      <li class="steps__item" {{ block.shopify_attributes }}>
        <span class="steps__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <h3 class="steps__title">{{ block.settings.title | escape }}</h3>
        <div class="steps__text rte">{{ block.settings.text }}</div>
      </li>
    {%- endfor -%}
  </ol>
  {%- if section.settings.button_label != blank -%}
    <div class="section__footer">
      <a class="button" href="{% render 'safe-url', fallback: section.settings.button_link_path %}">{{ section.settings.button_label | escape }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Steps",
  "class": "section-steps",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kanji", "label": "Japanese subtitle (kanji)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link_path", "label": "Button link path", "info": "e.g. /pages/contact" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose" } },
        { "type": "step", "settings": { "title": "Order" } },
        { "type": "step", "settings": { "title": "Wear it" } }
      ]
    }
  ]
}
{% endschema %}
