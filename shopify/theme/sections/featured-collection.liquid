{%- assign collection_obj = section.settings.collection | default: collections.all -%}
<section class="section page-width" style="--columns: {{ section.settings.columns }}; --columns-mobile: 2;">
  <div class="section__header section__header--split">
    <div>
      {% render 'kanji-kicker', text: section.settings.kanji %}
      {%- if section.settings.heading != blank -%}
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.show_view_all and collection_obj != blank -%}
      <a href="{{ collection_obj.url }}" class="link-arrow">{{ 'general.view_all' | t }} {% render 'icon', icon: 'arrow' %}</a>
    {%- endif -%}
  </div>

  <ul class="product-grid{% if section.settings.mobile_slider %} product-grid--slider{% endif %}">
    {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
      {%- for product in collection_obj.products limit: section.settings.limit -%}
        <li class="product-grid__item">{% render 'product-card', card_product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li class="product-grid__item">
          <div class="card">
            <div class="card__media ratio ratio--{{ settings.card_image_ratio }}">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder' }}
            </div>
            <div class="card__info">
              <h3 class="card__title">{{ 'products.product.example_title' | t }}</h3>
              <div class="price"><span class="price__current">{{ 69900 | money }}</span></div>
            </div>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "kanji",
      "label": "Japanese subtitle (kanji)",
      "info": "Shown small above the heading, e.g. 新作. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "label": "Swipe slider on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
