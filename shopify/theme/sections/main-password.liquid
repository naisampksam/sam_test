<section class="password">
  <div class="password__inner">
    <p class="header__logo-text">{{ shop.name }}</p>
    <h1 class="page-title">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
          <button type="submit" class="button">{{ 'newsletter.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link-underline">{{ 'general.password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter__form' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="newsletter__field">
          <input type="password" name="password" required placeholder="{{ 'general.password.password' | t }}" aria-label="{{ 'general.password.password' | t }}">
          <button type="submit" class="button">{{ 'general.password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something new is dropping soon" }
  ]
}
{% endschema %}
