{%- paginate search.results by 24 -%}
  <section class="page-width section" style="--columns: 4; --columns-mobile: 2;">
    <h1 class="page-title">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        aria-label="{{ 'general.search.title' | t }}"
      >
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <p class="muted">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <ul class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li class="product-grid__item">{% render 'product-card', card_product: item %}</li>
            {%- else -%}
              <li class="product-grid__item">
                <a href="{{ item.url }}" class="search-result">
                  <p class="card__title">{{ item.title | escape }}</p>
                  <p class="muted">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "class": "section-main-search"
}
{% endschema %}
