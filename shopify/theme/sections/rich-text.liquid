<section class="section page-width rich-text rich-text--{{ section.settings.alignment }}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <h2 class="section__heading" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
      {%- when 'text' -%}
        <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- when 'button' -%}
        <a href="{% render 'safe-url', url: block.settings.link %}" class="button" {{ block.shopify_attributes }}>
          {{ block.settings.label | escape }}
        </a>
    {%- endcase -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Made for everyday comfort" }]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Heavyweight cotton, relaxed oversized fits and colors you'll actually wear. Designed and printed in India.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }]
    }
  ]
}
{% endschema %}
