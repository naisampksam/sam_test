<section class="section page-width print-methods" style="--columns: {{ section.settings.columns }};">
  <div class="section__header section__header--center">
    {%- if section.settings.subheading != blank -%}
      <p class="eyebrow">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      {% render 'kanji-kicker', text: section.settings.kanji %}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="section__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <div class="print-methods__grid">
    {%- for block in section.blocks -%}
      <div class="print-method" {{ block.shopify_attributes }}>
        <div class="print-method__media ratio ratio--square">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 20vw, 50vw', alt: block.settings.title
            }}
          {%- elsif block.settings.asset_image != blank -%}
            <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="800">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <h3 class="print-method__title">{{ block.settings.title | escape }}</h3>
        {%- if block.settings.text != blank -%}
          <p class="print-method__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="section__footer">
      <a href="{% render 'safe-url', url: section.settings.button_link %}" class="button">
        {{ section.settings.button_label | escape }}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Print methods",
  "class": "section-print-methods",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kanji",
      "label": "Japanese subtitle (kanji)",
      "info": "Shown small above the heading, e.g. 新作. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Custom printing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your design. Our tees."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Upload your artwork and pick a print style. Perfect for brands, events, teams and gifts.</p>"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Design your tee"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Print method",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Fallback theme asset",
          "info": "File name from the theme's assets folder, used when no image is picked"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "DTF Print"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Vibrant full-color prints with fine detail."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Print methods",
      "blocks": [
        {
          "type": "method",
          "settings": {
            "asset_image": "print-dtf.jpg",
            "title": "DTF Print",
            "text": "Vibrant, full-color prints with fine detail. Great for artwork & photos."
          }
        },
        {
          "type": "method",
          "settings": {
            "asset_image": "print-screen.jpg",
            "title": "Screen Print",
            "text": "Bold, long-lasting solid colors. Best for bulk orders."
          }
        },
        {
          "type": "method",
          "settings": {
            "asset_image": "print-puff.jpg",
            "title": "Puff Print",
            "text": "Raised 3D texture that stands out. Premium streetwear finish."
          }
        },
        {
          "type": "method",
          "settings": {
            "asset_image": "print-hd.jpg",
            "title": "HD Print",
            "text": "High-density, tonal raised print with a clean luxury look."
          }
        },
        {
          "type": "method",
          "settings": {
            "asset_image": "print-embroidery.jpg",
            "title": "Embroidery",
            "text": "Stitched logos & patches built to last."
          }
        }
      ]
    }
  ]
}
{% endschema %}
