<section class="section page-width dojo">
  <div class="section__header section__header--split">
    <div>
      {% render 'kanji-kicker', text: section.settings.kanji %}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="section__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- assign dojo_link = section.settings.link | default: section.settings.link_path -%}
    {%- if dojo_link != blank -%}
      <a href="{{ dojo_link }}" class="link-arrow" target="_blank" rel="noopener">{{ section.settings.link_label | escape }} {% render 'icon', icon: 'arrow' %}</a>
    {%- endif -%}
  </div>
  <ul class="dojo__grid">
    {%- for block in section.blocks -%}
      <li class="dojo__item" {{ block.shopify_attributes }}>
        <div class="ratio ratio--square">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 33vw, 50vw', alt: block.settings.caption }}
          {%- elsif block.settings.asset_image != blank -%}
            <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="700" height="700">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        {%- if block.settings.caption != blank -%}<p class="dojo__caption">{{ block.settings.caption | escape }}</p>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Dojo lookbook",
  "class": "section-dojo",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "kanji",
      "label": "Japanese subtitle (kanji)",
      "default": "道場"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Dojo"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Warriors in HAIKUFIT. Tag @haikufit to be featured."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Follow on Instagram"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (e.g. your Instagram)"
    },
    {
      "type": "text",
      "id": "link_path",
      "label": "Or link path",
      "info": "e.g. /collections/bushido or /pages/our-story. Used when the link above is empty; falls back safely if the page doesn't exist yet."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Fallback theme asset"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dojo lookbook",
      "blocks": [
        {
          "type": "photo",
          "settings": {
            "asset_image": "dojo-1.jpg"
          }
        },
        {
          "type": "photo",
          "settings": {
            "asset_image": "dojo-2.jpg"
          }
        },
        {
          "type": "photo",
          "settings": {
            "asset_image": "dojo-3.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
