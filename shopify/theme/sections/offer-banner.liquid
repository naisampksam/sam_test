<section class="offer-banner offer-banner--{{ section.settings.style }}">
  <div class="page-width offer-banner__inner">
    <div class="offer-banner__intro">
      {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      <h2 class="offer-banner__heading">{{ section.settings.heading | default: settings.offer_heading | escape }}</h2>
      {%- if section.settings.show_countdown -%}{% render 'countdown', style: 'boxes' %}{%- endif -%}
    </div>

    <div class="offer-banner__tiers">
      {%- for i in (1..3) -%}
        {%- liquid
          assign qty_key = 'tier' | append: i | append: '_qty'
          assign disc_key = 'tier' | append: i | append: '_discount'
          assign qty = settings[qty_key]
          assign disc = settings[disc_key]
        -%}
        {%- if qty > 1 and disc > 0 -%}
          <div class="offer-card{% if forloop.index == 2 %} offer-card--featured{% endif %}">
            <p class="offer-card__buy">{{ 'offers.buy_qty' | t: qty: qty }}</p>
            <p class="offer-card__off">{{ disc }}%<span>{{ 'offers.off' | t }}</span></p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="offer-banner__cta">
      {%- if section.settings.show_coupon and section.settings.coupon != blank -%}
        <button type="button" class="offer-banner__coupon" data-copy="{{ section.settings.coupon | escape }}">
          {% render 'icon', icon: 'tag' %}
          <span>{{ 'offers.use_code' | t }} <b>{{ section.settings.coupon | escape }}</b></span>
          <small>{{ 'offers.tap_to_copy' | t }}</small>
        </button>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{% render 'safe-url', url: section.settings.button_link %}" class="button{% if section.settings.style == 'dark' %} button--light{% endif %}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
      {%- if settings.offer_note != blank -%}<p class="offer-banner__note">{{ settings.offer_note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offer banner",
  "class": "section-offer-banner",
  "settings": [
    { "type": "paragraph", "content": "Tiers come from Theme settings → Offers & conversion." },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Sale color" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Limited time offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy more, save more" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show sale countdown", "default": true },
    { "type": "checkbox", "id": "show_coupon", "label": "Show coupon", "default": true },
    { "type": "text", "id": "coupon", "label": "Coupon code", "default": "WELCOME10" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the offer" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Offer banner" }]
}
{% endschema %}
