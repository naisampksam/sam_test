{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign color_index = null
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign color_index = forloop.index0
    endif
  endfor
-%}

<section
  class="product page-width"
  data-product
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-color-index="{{ color_index }}"
  data-filter-media="{{ section.settings.filter_media_by_color }}"
>
  <div class="product__gallery" data-gallery>
    <ul class="product__media-list">
      {%- for media in product.media -%}
        <li
          class="product__media-item"
          data-media-id="{{ media.id }}"
          data-media-alt="{{ media.alt | downcase | strip | escape }}"
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.index < 3
                  assign loading = 'eager'
                endif
              -%}
              <div class="ratio ratio--portrait">
                {{
                  media
                  | image_url: width: 1500
                  | image_tag:
                    loading: loading,
                    widths: '450, 650, 900, 1200, 1500',
                    sizes: '(min-width: 990px) 30vw, 100vw',
                    alt: media.alt
                }}
              </div>
            {%- else -%}
              {{ media | media_tag: image_size: '1500x' }}
          {%- endcase -%}
        </li>
      {%- else -%}
        <li class="product__media-item">
          <div class="ratio ratio--portrait">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if product.media.size > 1 -%}
      <p class="product__gallery-count" aria-hidden="true"><span data-gallery-index>1</span> / <span data-gallery-total>{{ product.media.size }}</span></p>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- form 'product', product, id: form_id, class: 'product__form', data-product-form: '', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <p class="product__vendor eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
            {%- if block.settings.show_rating -%}
              <a href="#Reviews" class="product__rating">{% render 'stars', product: product, show_count: true %}</a>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product__price" data-price-wrapper {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, show_badge: true %}
              {%- liquid
                assign saving = 0
                if current_variant.compare_at_price > current_variant.price
                  assign saving = current_variant.compare_at_price | minus: current_variant.price
                endif
                assign saving_money = saving | money
              -%}
              <p class="product__saving" data-saving{% if saving == 0 %} hidden{% endif %}>
                {{ 'products.product.you_save' | t: amount: saving_money }}
              </p>
              <p class="product__tax">{{ 'products.product.tax_included' | t }}</p>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="product__options" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  {%- assign option_name = option.name | downcase -%}
                  {%- assign is_color = false -%}
                  {%- if option_name == 'color' or option_name == 'colour' -%}
                    {%- assign is_color = true -%}
                  {%- endif -%}
                  <fieldset class="option" data-option-index="{{ forloop.index0 }}">
                    <legend class="option__label">
                      {{ option.name | escape }}: <span data-option-value>{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="option__values{% if is_color %} option__values--swatch{% endif %}">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                        <input
                          type="radio"
                          class="visually-hidden"
                          id="{{ input_id }}"
                          name="option-{{ section.id }}-{{ option_index }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        {%- if is_color -%}
                          <label for="{{ input_id }}" class="swatch-label" title="{{ value | escape }}">
                            <span class="swatch" style="--swatch: {% render 'swatch-color', name: value %};"></span>
                            <span class="visually-hidden">{{ value | escape }}</span>
                          </label>
                        {%- else -%}
                          <label for="{{ input_id }}" class="pill">{{ value | escape }}</label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
              <script type="application/json" data-variants-json>
                {{ product.variants | json }}
              </script>
            {%- endunless -%}

          {%- when 'size_chart' -%}
            {%- liquid
              assign chart = product.metafields.custom.size_chart.value | default: block.settings.chart
              assign rows = chart | newline_to_br | split: '<br />'
            -%}
            <div class="size-chart" {{ block.shopify_attributes }}>
              <button type="button" class="link-underline size-chart__open" data-dialog-open="SizeChart-{{ section.id }}">
                {% render 'icon', icon: 'ruler' %} {{ 'products.product.size_chart' | t }}
              </button>
              <dialog class="dialog" id="SizeChart-{{ section.id }}">
                <div class="dialog__header">
                  <p class="dialog__title">{{ block.settings.heading | escape }}</p>
                  <button type="button" class="dialog__close" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
                    {% render 'icon', icon: 'close' %}
                  </button>
                </div>
                <div class="table-wrap">
                  <table class="size-table">
                    {%- for row in rows -%}
                      {%- assign row_clean = row | strip -%}
                      {%- if row_clean == blank -%}{%- continue -%}{%- endif -%}
                      {%- assign cells = row_clean | split: ',' -%}
                      {%- assign is_header_row = forloop.first -%}
                      <tr>
                        {%- for cell in cells -%}
                          {%- if is_header_row -%}
                            <th scope="col">{{ cell | strip | escape }}</th>
                          {%- else -%}
                            <td>{{ cell | strip | escape }}</td>
                          {%- endif -%}
                        {%- endfor -%}
                      </tr>
                    {%- endfor -%}
                  </table>
                </div>
                {%- if block.settings.note != blank -%}
                  <div class="rte dialog__note">{{ block.settings.note }}</div>
                {%- endif -%}
              </dialog>
            </div>

          {%- when 'custom_print' -%}
            <div class="custom-print" {{ block.shopify_attributes }}>
              <p class="option__label">{{ block.settings.heading | escape }}</p>

              {%- assign colors = block.settings.tee_colors | split: ',' -%}
              {%- if colors.size > 0 -%}
                <label class="field">
                  <span class="field__label">{{ 'products.custom_print.tee_color' | t }}</span>
                  <select name="properties[T-shirt color]" class="field__input">
                    {%- for c in colors -%}
                      <option value="{{ c | strip | escape }}">{{ c | strip | escape }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- endif -%}

              <label class="field">
                <span class="field__label">{{ 'products.custom_print.position' | t }}</span>
                <select name="properties[Print position]" class="field__input">
                  <option value="Front">{{ 'products.custom_print.front' | t }}</option>
                  <option value="Back">{{ 'products.custom_print.back' | t }}</option>
                  <option value="Front + Back">{{ 'products.custom_print.front_back' | t }}</option>
                  <option value="Left chest">{{ 'products.custom_print.left_chest' | t }}</option>
                </select>
              </label>

              <label class="field field--file">
                <span class="field__label">{{ 'products.custom_print.upload' | t }}{% if block.settings.require_file %} *{% endif %}</span>
                <span class="file-drop">
                  {% render 'icon', icon: 'upload' %}
                  <span data-file-name>{{ 'products.custom_print.upload_hint' | t }}</span>
                  <input
                    type="file"
                    name="properties[Design file]"
                    accept="image/png,image/jpeg,image/svg+xml,application/pdf"
                    data-design-upload
                    {% if block.settings.require_file %}required{% endif %}
                  >
                </span>
              </label>

              <label class="field">
                <span class="field__label">{{ 'products.custom_print.notes' | t }}</span>
                <textarea name="properties[Print instructions]" class="field__input" rows="3" placeholder="{{ 'products.custom_print.notes_placeholder' | t }}"></textarea>
              </label>
            </div>

          {%- when 'store_credit' -%}
            <div {{ block.shopify_attributes }}>{% render 'store-credit', mode: 'earn', amount: current_variant.price %}</div>

          {%- when 'offer_tiers' -%}
            <div {{ block.shopify_attributes }}>{% render 'offer-tiers', price: current_variant.price %}</div>

          {%- when 'coupons' -%}
            <div {{ block.shopify_attributes }}>{% render 'coupon-list' %}</div>

          {%- when 'countdown' -%}
            <div class="product__countdown" {{ block.shopify_attributes }}>{% render 'countdown', label: block.settings.label %}</div>

          {%- when 'stock' -%}
            {%- liquid
              assign low = false
              if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= settings.low_stock_threshold
                assign low = true
              endif
            -%}
            <p class="product__stock" data-low-stock {{ block.shopify_attributes }}{% unless low %} hidden{% endunless %}>
              <span class="product__stock-dot"></span>
              <span data-low-stock-text>{{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}</span>
            </p>
            <script type="application/json" data-stock-json>
              {
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign q = -1
                    if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= settings.low_stock_threshold
                      assign q = variant.inventory_quantity
                    endif
                  -%}
                  "{{ variant.id }}": {{ q }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              }
            </script>

          {%- when 'delivery' -%}
            {%- if settings.delivery_enable -%}
              <div class="delivery" data-delivery data-min="{{ settings.delivery_min_days }}" data-max="{{ settings.delivery_max_days }}" data-cutoff="{{ settings.dispatch_cutoff_hour }}" {{ block.shopify_attributes }}>
                <p class="delivery__line">
                  {% render 'icon', icon: 'truck' %}
                  <span>{{ 'delivery.get_it_by' | t }} <strong data-delivery-range>{{ 'delivery.days_range' | t: min: settings.delivery_min_days, max: settings.delivery_max_days }}</strong></span>
                </p>
                <p class="delivery__line delivery__cutoff" data-delivery-cutoff hidden>
                  {% render 'icon', icon: 'clock' %}
                  <span>{{ 'delivery.order_within' | t }} <strong data-delivery-countdown></strong> {{ 'delivery.dispatch_today' | t }}</span>
                </p>
                <div class="pincode" data-pincode>
                  {% render 'icon', icon: 'pin' %}
                  <input type="text" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="{{ 'delivery.pincode_placeholder' | t }}" aria-label="{{ 'delivery.pincode_placeholder' | t }}">
                  <button type="button" class="link-underline" data-pincode-check>{{ 'delivery.check' | t }}</button>
                </div>
                <p class="delivery__result muted" data-pincode-result hidden></p>
              </div>
            {%- endif -%}

          {%- when 'payment_icons' -%}
            <div class="product__payments" {{ block.shopify_attributes }}>
              <p class="muted">{% render 'icon', icon: 'lock' %} {{ 'trust.secure_payments' | t }}</p>
              <ul class="footer__payments">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'try_on' -%}
            {%- liquid
              assign tryon_map = ''
              capture tryon_map
                render 'tryon-map', handle: product.handle
              endcapture
              assign tryon_map = tryon_map | strip
              assign tryon_front = product.metafields.custom.tryon_front.value
              assign tryon_back = product.metafields.custom.tryon_back.value
              assign color_index = -1
              assign size_index = -1
              assign sizes = ''
              for option in product.options_with_values
                assign oname = option.name | downcase
                if oname == 'color' or oname == 'colour'
                  assign color_index = forloop.index0
                elsif oname == 'size'
                  assign size_index = forloop.index0
                  assign sizes = option.values | json
                endif
              endfor
              if sizes == blank
                assign sizes = '[]'
              endif
            -%}
            {%- liquid
              assign has_tryon = false
              if tryon_map != '{}' and tryon_map != blank
                assign has_tryon = true
              endif
              if tryon_front != blank or tryon_back != blank
                assign has_tryon = true
              endif
            -%}
            {%- if has_tryon -%}
              {{ 'tryon.css' | asset_url | stylesheet_tag }}
              <script src="{{ 'tryon.js' | asset_url }}" defer="defer"></script>
              {%- if block.settings.show_3d -%}
                <script src="{{ 'view3d.js' | asset_url }}" defer="defer"></script>
              {%- endif -%}
              <div class="tryon-cta" data-tryon {{ block.shopify_attributes }}>
                <button type="button" class="tryon-cta__button" data-tryon-open>
                  <span class="tryon-cta__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                  </span>
                  <span class="tryon-cta__text">
                    <b>{{ block.settings.label | escape }}</b>
                    <small>{{ block.settings.sublabel | escape }}</small>
                  </span>
                  <span class="tryon-cta__live">LIVE</span>
                </button>
                {%- if block.settings.show_3d -%}
                  <button type="button" class="tryon-cta__3d" data-view3d-open>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9Z"/><path d="M4 7.5 12 12l8-4.5M12 12v9"/></svg>
                    {{ block.settings.label_3d | escape }}
                  </button>
                {%- endif -%}
                {%- liquid
                  if tryon_front != blank or tryon_back != blank
                    assign override_front = ''
                    assign override_back = ''
                    if tryon_front != blank
                      assign override_front = tryon_front | image_url: width: 900
                    endif
                    if tryon_back != blank
                      assign override_back = tryon_back | image_url: width: 900
                    endif
                    assign front_json = override_front | json
                    assign back_json = override_back | json
                    assign tryon_map = '{"all colours":{"front":' | append: front_json | append: ',"back":' | append: back_json | append: '}}'
                  endif
                -%}
                <script type="application/json" data-tryon-config>
                  {
                    "title": {{ product.title | json }},
                    "map": {{ tryon_map }},
                    "assetBase": {{ 'tryon-ronin-black-front.png' | asset_url | split: 'tryon-ronin-black-front.png' | first | json }},
                    "colorIndex": {{ color_index }},
                    "sizeIndex": {{ size_index }},
                    "sizes": {{ sizes }},
                    "visionUrl": {{ block.settings.vision_url | json }},
                    "modelUrl": {{ block.settings.model_url | json }},
                    "segUrl": {{ block.settings.seg_url | json }},
                    "modelFullUrl": {{ block.settings.model_full_url | json }},
                    "threeUrl": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js",
                    "strings": {
                      "title": "Live try-on",
                      "live": "LIVE TRY-ON",
                      "close": "Close",
                      "switchCamera": "Switch camera",
                      "starting": "Starting your camera…",
                      "loadingTracking": "Loading body tracking… (first time takes a few seconds)",
                      "findBody": "Step back so your shoulders and waist are in the frame",
                      "noTracking": "Auto-fit isn't available on this device. Drag the tee into place and use the slider to size it.",
                      "noBody": "Couldn't find your shoulders. Drag the tee into place and use the slider to size it.",
                      "cameraBlocked": "Camera is off. Allow camera access in your browser, or upload a photo instead.",
                      "guide": "Stand back so your head to waist fits the screen, facing the camera",
                      "view": "View",
                      "front": "Front",
                      "back": "Back",
                      "size": "Size",
                      "adjust": "Size on screen",
                      "autoFit": "Auto-fit again",
                      "snap": "Snap",
                      "realistic": "Realistic",
                      "closer": "Come a little closer",
                      "farther": "Step back a little so your waist is in view",
                      "showWaist": "Step back so your waist is in the frame for the best fit",
                      "tooDark": "It's a bit dark. Face a window or a light",
                      "faceCamera": "Face the camera straight on",
                      "view3d": "360° 3D view",
                      "loading3d": "Building the 3D tee…",
                      "hint3d": "Drag to spin · pinch to zoom",
                      "autoSpin": "Spin",
                      "tryOnLive": "Try it on live",
                      "error3d": "3D isn't supported on this device.",
                      "realisticHint": "Replaces the colour of what you're wearing and copies its folds and light onto the tee",
                      "addToCart": "Add to cart",
                      "soldOut": "Sold out",
                      "error": "Something went wrong. Please try again.",
                      "privacy": {{ block.settings.privacy | json }},
                      "upload": "Use a photo instead",
                      "save": "Save photo",
                      "share": "Share",
                      "backToCamera": "Back to camera",
                      "shareText": "Trying on my next HAIKUFIT tee ⚔️ haikufit.in"
                    }
                  }
                </script>
              </div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              <div class="quantity" data-quantity>
                <button type="button" class="quantity__button" data-qty-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">−</button>
                <input type="number" name="quantity" value="1" min="1" class="quantity__input" aria-label="{{ 'products.product.quantity' | t }}">
                <button type="button" class="quantity__button" data-qty-plus aria-label="{{ 'products.product.quantity_increase' | t }}">+</button>
              </div>
              <button
                type="submit"
                name="add"
                class="button button--full"
                data-add-to-cart
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-add-to-cart-text>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>
              {%- if block.settings.show_dynamic_checkout -%}
                <div class="product__dynamic-checkout">{{ form | payment_button }}</div>
              {%- endif -%}
              <p class="form-message form-message--error" data-form-error hidden></p>
            </div>

          {%- when 'highlights' -%}
            <ul class="product__highlights" {{ block.shopify_attributes }}>
              {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign line_clean = line | strip -%}
                {%- if line_clean != blank -%}
                  <li>{{ line_clean | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'description' -%}
            {%- capture description_html -%}{% render 'design-story', product: product, part: 'rest' %}{%- endcapture -%}
            {%- if description_html != blank -%}
              <details class="accordion" open {{ block.shopify_attributes }}>
                <summary>{{ 'products.product.description' | t }} {% render 'icon', icon: 'chevron' %}</summary>
                <div class="accordion__content rte">{{ description_html }}</div>
              </details>
            {%- endif -%}

          {%- when 'design_story' -%}
            {%- capture story_html -%}{% render 'design-story', product: product, part: 'story' %}{%- endcapture -%}
            {%- if story_html != blank -%}
              <div class="design-story" lang="en" {{ block.shopify_attributes }}>
                <p class="design-story__label">{{ block.settings.heading | escape }}</p>
                {{ story_html }}
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }} {% render 'icon', icon: 'chevron' %}</summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {{ block.settings.page.content }}
              </div>
            </details>

          {%- when 'trust' -%}
            <ul class="product__trust" {{ block.shopify_attributes }}>
              <li>{% render 'icon', icon: 'truck' %} {{ block.settings.line_1 | escape }}</li>
              <li>{% render 'icon', icon: 'cash' %} {{ block.settings.line_2 | escape }}</li>
              <li>{% render 'icon', icon: 'return' %} {{ block.settings.line_3 | escape }}</li>
            </ul>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    {%- endform -%}
  </div>
</section>

{%- if section.settings.sticky_atc -%}
  <div class="sticky-atc" data-sticky-atc hidden>
    <div class="page-width sticky-atc__inner">
      <div class="sticky-atc__product">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
        <div>
          <p class="sticky-atc__title">{{ product.title | escape }}</p>
          <p class="sticky-atc__variant muted" data-sticky-variant>{% unless product.has_only_default_variant %}{{ current_variant.title | escape }}{% endunless %}</p>
        </div>
      </div>
      <div class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</div>
      <button type="button" class="button" data-sticky-add{% unless current_variant.available %} disabled{% endunless %}>
        {{ 'products.product.add_to_cart' | t }}
      </button>
    </div>
  </div>
{%- endif -%}

<script type="application/json" data-recent-product>
  {
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "image": {{ product.featured_image | image_url: width: 600 | json }},
    "price": {{ product.price | json }},
    "compare": {{ product.compare_at_price | default: 0 | json }}
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}
    "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
        "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ variant.price | divided_by: 100.00 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "filter_media_by_color",
      "label": "Only show images of the selected color",
      "info": "Set each image's alt text to the color name (e.g. \"Black\") for this to work.",
      "default": true
    },
    { "type": "checkbox", "id": "sticky_atc", "label": "Sticky add to cart bar on scroll", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "offer_tiers", "name": "Bundle offer tiers", "limit": 1 },
    { "type": "coupons", "name": "Coupon codes", "limit": 1 },
    {
      "type": "countdown",
      "name": "Sale countdown",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Sale ends in" }]
    },
    { "type": "stock", "name": "Low stock alert", "limit": 1 },
    { "type": "delivery", "name": "Delivery estimate", "limit": 1 },
    { "type": "payment_icons", "name": "Payment icons", "limit": 1 },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [{ "type": "checkbox", "id": "show_rating", "label": "Show star rating (needs a reviews app)", "default": true }]
    },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "size_chart",
      "name": "Size chart",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Size chart (inches)" },
        {
          "type": "textarea",
          "id": "chart",
          "label": "Chart (comma separated, first row is the header)",
          "info": "A product metafield custom.size_chart (multi-line text) overrides this.",
          "default": "Size,Chest,Length,Shoulder,Sleeve\nS,42,27.5,21,8.5\nM,44,28.5,22,9\nL,46,29.5,23,9.5\nXL,48,30.5,24,10\nXXL,50,31.5,25,10.5"
        },
        { "type": "richtext", "id": "note", "label": "Note", "default": "<p>Oversized fit — take your regular size for a relaxed look, or size down for a closer fit.</p>" }
      ]
    },
    {
      "type": "custom_print",
      "name": "Custom print upload",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customise your tee" },
        { "type": "text", "id": "tee_colors", "label": "T-shirt colors (comma separated)", "default": "Black, White, Beige, Bottle Green, Chocolate, Lavender, Navy, Royal Blue, Red" },
        { "type": "checkbox", "id": "require_file", "label": "Require design upload", "default": true }
      ]
    },
    { "type": "store_credit", "name": "Store credit", "limit": 1, "settings": [{ "type": "paragraph", "content": "Amounts and messages are set in Theme settings > Store credit." }] },
    {
      "type": "try_on",
      "name": "Live try-on",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows a 'Try it on' button when the product has try-on cutouts (theme assets tryon-*.png) or the metafields custom.tryon_front / custom.tryon_back (image files with transparent background)." },
        { "type": "text", "id": "label", "label": "Button label", "default": "Try it on: live camera" },
        { "type": "text", "id": "sublabel", "label": "Button subtext", "default": "See this tee on you in seconds" },
        { "type": "text", "id": "privacy", "label": "Privacy note", "default": "Your camera stays on your phone. Nothing is recorded or uploaded." },
        { "type": "text", "id": "vision_url", "label": "Body tracking library URL", "info": "Advanced. Leave as is.", "default": "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14" },
        { "type": "text", "id": "model_url", "label": "Body tracking model URL", "info": "Advanced. Leave as is. Clear it to use drag-to-place only.", "default": "https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task" },
        { "type": "text", "id": "model_full_url", "label": "Precise body tracking model URL", "info": "Advanced. Used on computers and powerful phones for more accurate shoulders and hips. Clear it to always use the fast model.", "default": "https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/1/pose_landmarker_full.task" },
        { "type": "text", "id": "seg_url", "label": "Clothes detection model URL", "info": "Advanced. Powers 'Realistic' mode (replaces the shopper's own top). Clear it to turn Realistic mode off.", "default": "https://storage.googleapis.com/mediapipe-models/image_segmenter/selfie_multiclass_256x256/float32/latest/selfie_multiclass_256x256.tflite" },
        { "type": "checkbox", "id": "show_3d", "label": "Show 360° 3D view button", "default": true },
        { "type": "text", "id": "label_3d", "label": "3D button label", "default": "View in 3D · 360°" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show 'Buy it now' button", "default": true }
      ]
    },
    {
      "type": "highlights",
      "name": "Highlights",
      "settings": [
        {
          "type": "textarea",
          "id": "items",
          "label": "Highlights (one per line)",
          "default": "100% cotton, bio-washed\nPre-shrunk & colorfast\nDrop shoulder, relaxed fit"
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "design_story",
      "name": "Design story",
      "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Label", "default": "The story behind the design" }]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Dispatched in 24–48 hours. Delivered in 3–7 business days across India. Easy 7-day exchange.</p>" },
        { "type": "page", "id": "page", "label": "Content from page" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust lines",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "line_1", "label": "Line 1", "default": "Free shipping above ₹999" },
        { "type": "text", "id": "line_2", "label": "Line 2", "default": "Cash on delivery available" },
        { "type": "text", "id": "line_3", "label": "Line 3", "default": "Easy 7-day exchange" }
      ]
    }
  ]
}
{% endschema %}
