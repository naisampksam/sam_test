{{ 'dojo-run.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dojo-run.js' | asset_url }}" defer="defer"></script>

{%- comment -%} With a rewards server the fixed codes are never printed into the page. {%- endcomment -%}
{%- liquid
  assign tiers_json = ''
  assign reward_api = settings.dojo_reward_api | strip
  for i in (1..3)
    assign score_key = 'tier' | append: i | append: '_score'
    assign pct_key = 'tier' | append: i | append: '_percent'
    assign code_key = 'tier' | append: i | append: '_code'
    assign t_score = section.settings[score_key]
    assign t_pct = section.settings[pct_key]
    assign t_code = section.settings[code_key] | strip | upcase
    assign t_ok = false
    if t_score > 0 and t_pct > 0
      if t_code != blank or reward_api != blank
        assign t_ok = true
      endif
    endif
    if t_ok
      assign tier_obj = '{"score":' | append: t_score | append: ',"percent":' | append: t_pct
      if reward_api == blank
        assign code_json = t_code | json
        assign tier_obj = tier_obj | append: ',"code":' | append: code_json
      endif
      assign tier_obj = tier_obj | append: '}'
      if tiers_json != blank
        assign tiers_json = tiers_json | append: ','
      endif
      assign tiers_json = tiers_json | append: tier_obj
    endif
  endfor
-%}

<section class="dojo-run section{% if section.settings.dark %} dojo-run--dark{% endif %}" data-dojo-run id="DojoRun-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header section__header--center">
        {% render 'kanji-kicker', text: section.settings.kanji %}
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="section__subheading rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="dojo-run__tiers" role="list">
      {%- for i in (1..3) -%}
        {%- liquid
          assign score_key = 'tier' | append: i | append: '_score'
          assign pct_key = 'tier' | append: i | append: '_percent'
          assign code_key = 'tier' | append: i | append: '_code'
        -%}
        {%- liquid
          assign pill_ok = false
          if section.settings[score_key] > 0 and section.settings[pct_key] > 0
            if section.settings[code_key] != blank or reward_api != blank
              assign pill_ok = true
            endif
          endif
        -%}
        {%- if pill_ok -%}
          <li class="dojo-run__tier" data-tier-pill="{{ section.settings[score_key] }}">
            <span class="dojo-run__tier-pct">{{ section.settings[pct_key] }}% OFF</span>
            <span class="dojo-run__tier-score">{{ section.settings[score_key] }} pts</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="dojo-run__stage" data-dojo-stage tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      <canvas class="dojo-run__canvas" aria-hidden="true"></canvas>

      <div class="dojo-run__hud" aria-live="off">
        <span class="dojo-run__best" data-dojo-best>HI 00000</span>
        <span class="dojo-run__score" data-dojo-score>00000</span>
      </div>
      <p class="dojo-run__toast" data-dojo-toast aria-live="polite"></p>

      <div class="dojo-run__overlay is-visible" data-screen="start">
        <div class="dojo-run__card">
          <p class="dojo-run__kanji" aria-hidden="true"><span lang="ja" data-en="Samurai">侍</span></p>
          <p class="dojo-run__title">{{ section.settings.start_title | escape }}</p>
          <ul class="dojo-run__keys" role="list">
            <li><kbd>Space</kbd> / <kbd>↑</kbd> / Tap <span>Jump (hold = higher)</span></li>
            <li><kbd>↓</kbd> / Swipe down <span>Duck under arrows</span></li>
            <li><kbd>X</kbd> <span>Slash ninjas, arrows & shuriken (+15)</span></li>
          </ul>
          {%- if section.settings.record_score > 0 -%}
            <p class="dojo-run__record">
              <span>{{ section.settings.record_label | escape }}</span>
              <b>{{ section.settings.record_score }}</b>
              {%- if section.settings.record_name != blank %} · {{ section.settings.record_name | escape }}{% endif -%}
            </p>
          {%- endif -%}
          <p class="dojo-run__start-meta" data-dojo-start-meta hidden></p>
          <div class="dojo-run__go">
            <button type="button" class="button dojo-run__start" data-dojo-start>{{ section.settings.start_label | escape }}</button>
            <button type="button" class="dojo-run__sound" data-dojo-sound aria-pressed="true">
              <svg class="dojo-run__sound-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path class="dojo-run__sound-waves" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="dojo-run__sound-x" d="M16 9l6 6M22 9l-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <span data-dojo-sound-label>Sound on</span>
            </button>
          </div>
        </div>
      </div>

      <div class="dojo-run__overlay" data-screen="over" hidden>
        <div class="dojo-run__card" data-dojo-over-body></div>
      </div>

      <button type="button" class="dojo-run__mute" data-dojo-sound aria-pressed="true" title="Sound (M)">
        <svg class="dojo-run__sound-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path class="dojo-run__sound-waves" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="dojo-run__sound-x" d="M16 9l6 6M22 9l-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>

      <div class="dojo-run__overlay dojo-run__overlay--pause" data-screen="pause" hidden>
        <div class="dojo-run__card">
          <p class="dojo-run__title">Paused</p>
          <p class="dojo-run__hint">Tap or press Space to continue</p>
        </div>
      </div>
    </div>

    <div class="dojo-run__controls">
      <button type="button" class="dojo-run__btn" data-dojo-btn="duck" aria-label="Duck">
        <span aria-hidden="true">▼</span> Duck
      </button>
      <button type="button" class="dojo-run__btn dojo-run__btn--slash" data-dojo-btn="slash" aria-label="Slash">
        <span aria-hidden="true">斬</span> Slash
      </button>
      <button type="button" class="dojo-run__btn dojo-run__btn--jump" data-dojo-btn="jump" aria-label="Jump">
        <span aria-hidden="true">▲</span> Jump
      </button>
    </div>

    {%- if section.settings.terms != blank -%}
      <p class="dojo-run__terms">{{ section.settings.terms | escape }}</p>
    {%- endif -%}
  </div>

  <script type="application/json" data-dojo-config>
    {
      "tiers": [{{ tiers_json }}],
      "record": { "score": {{ section.settings.record_score | default: 0 }} },
      "sound": {{ section.settings.sound | json }},
      "rewardApi": {{ reward_api | json }},
      "dailyRuns": {{ section.settings.daily_runs | default: 0 }},
      "root": {{ routes.root_url | append: '/' | replace: '//', '/' | json }},
      "shopUrl": {{ routes.all_products_collection_url | json }},
      "strings": {
        "score": "Score",
        "soundOn": "Sound on",
        "soundOff": "Sound off",
        "mute": "Mute sound",
        "unmute": "Turn sound on",
        "best": "Your best",
        "newBest": "New personal best!",
        "victory": "Victory, warrior!",
        "defeated": "You have fallen",
        "unlocked": "You unlocked __PERCENT__% OFF",
        "copy": "Tap to copy",
        "copied": "Copied!",
        "apply": "Shop now with __PERCENT__% off",
        "claiming": "Forging your personal code…",
        "expires": "Single-use code · valid till __DATE__",
        "claimLimit": "You've already claimed today's rewards. Use your code, and come back tomorrow for more.",
        "claimInvalid": "We couldn't verify this run, so no code was created. Please fight again.",
        "claimFailed": "We couldn't create your code just now. Please fight again in a moment.",
        "applied": "Added to your cart automatically. Saved even if you play again.",
        "saved": "Your saved reward: __PERCENT__% OFF",
        "left": "__N__ left today",
        "rested": {{ section.settings.rested_text | json }},
        "restedTitle": "Your blade needs rest",
        "shopAll": "Shop all designs",
        "nextTier": "Reach __SCORE__ to unlock __PERCENT__% OFF",
        "reachTier": "Reach __SCORE__ points to unlock __PERCENT__% OFF",
        "again": "Fight again",
        "hintAgain": "Press Space or tap to retry",
        "toastUnlock": "__PERCENT__% OFF UNLOCKED!",
        "recordBeaten": {{ section.settings.record_text | json }}
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "Dojo Run game",
  "tag": "div",
  "class": "section-dojo-run",
  "settings": [
    { "type": "text", "id": "kanji", "label": "Japanese subtitle (kanji)", "default": "道場" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dojo Run: win up to 15% off" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Leap bamboo spikes, duck the arrows and slash the ninjas. The further you run, the bigger your reward.</p>"
    },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    {
      "type": "checkbox",
      "id": "sound",
      "label": "Sound effects on by default",
      "info": "Sword, drum, gong and war-horn sound effects. Players can mute with the sound button or the M key; their choice is remembered.",
      "default": true
    },
    { "type": "header", "content": "Rewards" },
    {
      "type": "paragraph",
      "content": "Unique codes: set the rewards server URL in Theme settings → Dojo Run rewards. Without it, the fixed codes below are used. Anyone can share or find them, so create each in Shopify admin → Discounts with a usage limit and minimum order value."
    },
    { "type": "number", "id": "tier1_score", "label": "Tier 1 score", "default": 300 },
    { "type": "number", "id": "tier1_percent", "label": "Tier 1 discount %", "default": 5 },
    { "type": "text", "id": "tier1_code", "label": "Tier 1 discount code", "default": "DOJO5" },
    { "type": "number", "id": "tier2_score", "label": "Tier 2 score", "default": 600 },
    { "type": "number", "id": "tier2_percent", "label": "Tier 2 discount %", "default": 10 },
    { "type": "text", "id": "tier2_code", "label": "Tier 2 discount code", "default": "DOJO10" },
    { "type": "number", "id": "tier3_score", "label": "Tier 3 score", "default": 1000 },
    { "type": "number", "id": "tier3_percent", "label": "Tier 3 discount %", "default": 15 },
    { "type": "text", "id": "tier3_code", "label": "Tier 3 discount code", "default": "DOJO15" },
    {
      "type": "number",
      "id": "daily_runs",
      "label": "Battles per day (0 = unlimited)",
      "info": "Limits how many games a visitor can play each day so they use their reward instead of grinding for a bigger one.",
      "default": 5
    },
    {
      "type": "text",
      "id": "rested_text",
      "label": "Message when daily battles are used up",
      "default": "You've used today's battles. Your reward is saved, so use it now, and come back tomorrow to fight for more."
    },
    {
      "type": "text",
      "id": "terms",
      "label": "Terms (small print)",
      "default": "One reward per customer. Minimum order ₹799. Not combinable with bundle offers. HAIKUFIT may change or end this offer at any time."
    },
    { "type": "header", "content": "All-time record" },
    {
      "type": "paragraph",
      "content": "Players' own best score is saved on their device. Update the all-time record below when someone sends you a screenshot of a higher score."
    },
    { "type": "text", "id": "record_label", "label": "Record label", "default": "All-time record" },
    { "type": "number", "id": "record_score", "label": "All-time record score", "default": 1500 },
    { "type": "text", "id": "record_name", "label": "Record holder", "default": "Shogun Kenji" },
    {
      "type": "text",
      "id": "record_text",
      "label": "Message when record beaten",
      "default": "NEW ALL-TIME RECORD! Screenshot this and DM us on Instagram to claim your title and a free tee."
    },
    { "type": "header", "content": "Start screen" },
    { "type": "text", "id": "start_title", "label": "Title", "default": "Dojo Run" },
    { "type": "text", "id": "start_label", "label": "Button label", "default": "Start the battle" }
  ],
  "presets": [{ "name": "Dojo Run game" }]
}
{% endschema %}
