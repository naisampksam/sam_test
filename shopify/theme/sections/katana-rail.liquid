{%- comment -%}
  Clothing rail: tees hang from a steel rail. Swipe the rail; the tee in the middle turns to face you.
  Tap it for a close-up with every colour, the price and quick add.
{%- endcomment -%}
{%- liquid
  assign handle = section.settings.collection_handle | strip | default: 'all'
  assign rail_collection = collections[handle]
  if rail_collection == blank or rail_collection.id == blank
    assign rail_collection = collections.all
  endif
  assign skip_types = section.settings.skip_types | downcase | split: ','
-%}
{{ 'katana-rail.css' | asset_url | stylesheet_tag }}
<script src="{{ 'katana-rail.js' | asset_url }}" defer="defer"></script>

<section class="section katana-rail" style="--rail-bg: {{ section.settings.background }};" data-katana-rail aria-roledescription="carousel" aria-label="{{ section.settings.eyebrow | escape }}">
  <div class="page-width katana-rail__head">
    <p class="katana-rail__eyebrow">
      {%- if section.settings.kanji != blank -%}<span class="katana-rail__kanji" lang="ja">{{ section.settings.kanji | escape }}</span>{%- endif -%}
      {{ section.settings.eyebrow | escape }}
      {%- if section.settings.eyebrow_2 != blank -%}<span class="katana-rail__sep">|</span><span class="katana-rail__muted">{{ section.settings.eyebrow_2 | escape }}</span>{%- endif -%}
    </p>
  </div>

  <div class="katana-rail__stage">
    {%- comment -%} A polished steel clothing rail with wall mounts {%- endcomment -%}
    <div class="rail-rod" aria-hidden="true">
      <span class="rail-rod__mount rail-rod__mount--left"></span>
      <span class="rail-rod__bar"></span>
      <span class="rail-rod__mount rail-rod__mount--right"></span>
    </div>

    <ul class="katana-rail__track" data-rail-track role="list">
      {%- assign shown = 0 -%}
      {%- for product in rail_collection.products -%}
        {%- assign ptype = product.type | downcase | strip -%}
        {%- if skip_types contains ptype -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign shown = shown | plus: 1
          assign hang_image = product.featured_image
          for img in product.images
            assign alt = img.alt | downcase
            if alt contains section.settings.hang_colour_word
              assign hang_image = img
              break
            endif
          endfor
        -%}
        <li class="katana-rail__item" data-rail-item data-index="{{ forloop.index0 }}">
          <button type="button" class="katana-rail__hang" data-rail-open aria-label="{{ product.title | escape }}, {{ product.price | money_without_trailing_zeros | strip_html }}">
            <svg class="katana-rail__hanger" viewBox="0 0 24 40" aria-hidden="true"><path d="M12 40 V17 C12 13 18 13 18 8 C18 3 14 1 11 1 C7 1 5 4 5 7" fill="none" stroke="#3b3b3b" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span class="katana-rail__tag" aria-hidden="true">{{ product.price | money_without_trailing_zeros }}</span>
            <span class="katana-rail__garment" data-rail-garment>
              {%- if hang_image -%}
                {{ hang_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 450, 700', sizes: '(min-width: 990px) 280px, 46vw', alt: '', class: 'katana-rail__img', draggable: 'false' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'katana-rail__img placeholder' }}
              {%- endif -%}
            </span>
          </button>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="page-width katana-rail__info">
    <p class="katana-rail__counter" aria-hidden="true"><span data-rail-current>01</span> / {{ shown | prepend: '0' | slice: -2, 2 }}</p>
    <p class="katana-rail__title" data-rail-title aria-live="polite"></p>
    <p class="katana-rail__price" data-rail-price></p>
    <div class="katana-rail__dots" data-rail-dots aria-hidden="true"></div>
    {%- if section.settings.button_label != blank -%}
      <a class="button button--secondary katana-rail__cta" href="{{ section.settings.button_link | default: rail_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>

  {%- comment -%} Close-up data: one entry per tee on the rail (every colour image) {%- endcomment -%}
  <script type="application/json" data-rail-data>
    [
      {%- assign shown = 0 -%}
      {%- assign first = true -%}
      {%- for product in rail_collection.products -%}
        {%- assign ptype = product.type | downcase | strip -%}
        {%- if skip_types contains ptype -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
        {
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "price": {{ product.price | money_without_trailing_zeros | strip_html | json }},
          "views": [
            {%- assign vfirst = true -%}
            {%- for img in product.images limit: 8 -%}
              {%- assign alt = img.alt | default: '' -%}
              {%- assign label = '' -%}
              {%- if alt contains ' in ' -%}{%- assign label = alt | split: ' in ' | last | strip -%}{%- endif -%}
              {%- if label != blank or forloop.first -%}
                {%- unless vfirst -%},{%- endunless -%}{%- assign vfirst = false -%}
                { "label": {{ label | default: section.settings.design_label | json }}, "src": {{ img | image_url: width: 1000 | json }} }
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      {%- endfor -%}
    ]
  </script>

  <dialog class="rail-sheet" data-rail-sheet aria-label="{{ section.settings.eyebrow | escape }}">
    <button type="button" class="rail-sheet__close" data-rail-close>{{ 'general.close' | t }} <span aria-hidden="true">×</span></button>
    <div class="rail-sheet__media"><img data-rail-sheet-img alt="" width="1000" height="1000"></div>
    <p class="rail-sheet__counter" data-rail-sheet-counter></p>
    <h3 class="rail-sheet__title" data-rail-sheet-title></h3>
    <p class="rail-sheet__price" data-rail-sheet-price></p>
    <div class="rail-sheet__views" data-rail-sheet-views role="tablist"></div>
    <div class="rail-sheet__actions">
      <button type="button" class="button button--full" data-rail-quick-add>{{ 'products.product.add_to_cart' | t }}</button>
      <a class="link-underline rail-sheet__details" data-rail-sheet-link href="#">{{ section.settings.details_label | escape }}</a>
    </div>
  </dialog>
</section>

{% schema %}
{
  "name": "Clothing rail",
  "class": "section-katana-rail",
  "settings": [
    { "type": "text", "id": "kanji", "label": "Japanese subtitle (kanji)", "default": "新作" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New collection" },
    { "type": "text", "id": "eyebrow_2", "label": "Eyebrow, second part", "default": "Premium oversized tees" },
    { "type": "color", "id": "background", "label": "Rail background", "info": "Match your product photos' background so they blend in.", "default": "#EFE9DD" },
    { "type": "text", "id": "collection_handle", "label": "Collection handle", "info": "Leave as 'all' for every product.", "default": "all" },
    { "type": "range", "id": "limit", "label": "Tees on the rail", "min": 3, "max": 16, "step": 1, "default": 10 },
    { "type": "text", "id": "skip_types", "label": "Skip product types (comma separated)", "default": "gift box,couple combo" },
    { "type": "text", "id": "hang_colour_word", "label": "Hang the image whose alt text contains", "info": "e.g. 'black' uses each tee's black photo on the rail.", "default": "black" },
    { "type": "text", "id": "design_label", "label": "Label for the main image", "default": "Design" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "details_label", "label": "Product link label", "default": "Full details" }
  ],
  "presets": [{ "name": "Clothing rail" }]
}
{% endschema %}
