<section class="virtues virtues--{{ section.settings.style }}">
  <div class="page-width">
    <div class="section__header section__header--center">
      {% render 'kanji-kicker', text: section.settings.kanji %}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="section__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <ol class="virtues__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.product != blank
            assign href = block.settings.product.url
          else
            capture href
              render 'safe-url', url: block.settings.link
            endcapture
          endif
        -%}
        <li class="virtue" {{ block.shopify_attributes }}>
          <a href="{{ href }}" class="virtue__link">
            <span class="virtue__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="virtue__kanji" lang="ja">{{ block.settings.kanji | escape }}</span>
            <span class="virtue__romaji">{{ block.settings.romaji | escape }}</span>
            <span class="virtue__meaning">{{ block.settings.meaning | escape }}</span>
            {%- if block.settings.text != blank -%}
              <span class="virtue__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
            <span class="virtue__cta">{{ 'general.shop_now' | t }} {% render 'icon', icon: 'arrow' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.button_label != blank -%}
      <div class="section__footer">
        <a href="{% render 'safe-url', url: section.settings.button_link %}" class="button{% if section.settings.style == 'dark' %} button--light{% endif %}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bushidō virtues",
  "class": "section-virtues",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "dark", "label": "Ink (dark)" },
        { "value": "light", "label": "Paper (light)" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "kanji", "label": "Japanese subtitle (kanji)", "default": "武士道" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The seven virtues" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The code of the samurai, one virtue on every tee. Collect them all.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Bushidō collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "virtue",
      "name": "Virtue",
      "settings": [
        { "type": "text", "id": "kanji", "label": "Kanji", "default": "義" },
        { "type": "text", "id": "romaji", "label": "Romaji", "default": "Gi" },
        { "type": "text", "id": "meaning", "label": "Meaning", "default": "Rectitude" },
        { "type": "text", "id": "text", "label": "Short line" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "url", "id": "link", "label": "Link (if no product is chosen)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bushidō virtues",
      "blocks": [
        { "type": "virtue", "settings": { "kanji": "義", "romaji": "Gi", "meaning": "Rectitude" } },
        { "type": "virtue", "settings": { "kanji": "勇", "romaji": "Yū", "meaning": "Courage" } },
        { "type": "virtue", "settings": { "kanji": "仁", "romaji": "Jin", "meaning": "Compassion" } },
        { "type": "virtue", "settings": { "kanji": "礼", "romaji": "Rei", "meaning": "Respect" } },
        { "type": "virtue", "settings": { "kanji": "誠", "romaji": "Makoto", "meaning": "Honesty" } },
        { "type": "virtue", "settings": { "kanji": "名誉", "romaji": "Meiyo", "meaning": "Honour" } },
        { "type": "virtue", "settings": { "kanji": "忠義", "romaji": "Chūgi", "meaning": "Loyalty" } }
      ]
    }
  ]
}
{% endschema %}
