    "faq": {
      "type": "faq",
      "blocks": {
        "q0": {
          "type": "question",
          "settings": {
            "question": "How does the Buy 2 / Buy 3 offer work?",
            "answer": "<p>Add any 2 tees to get 10% off, any 3 to get 15% off, or 5+ to get 20% off. Mix and match colors, sizes and styles. The discount is applied automatically at checkout.</p>"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "<p>Yes, COD is available across India for a small ₹49 COD fee (shown at checkout). Pay online with UPI, card or net banking and there's no extra fee.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "What size should I buy?",
            "answer": "<p>Our oversized tees are designed to be roomy. Take your regular size for a relaxed fit, or one size down for a closer fit. Check the size chart on each product page.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders are dispatched within 24–48 hours and delivered in 3–6 business days in most cities.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "What is your return & exchange policy?",
            "answer": "<p>Free size exchange within 7 days of delivery on unworn tees with tags (once per order). Design or colour swaps have a ₹99 pickup fee. Refunds are for damaged, defective or wrong items. Custom prints and gift boxes can't be exchanged. Details on our <a href=\"/pages/returns-exchanges\">returns & exchanges</a> page.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Will sold-out sizes come back?",
            "answer": "<p>Most designs are restocked within 2–3 weeks. Join the clan newsletter below to hear first when your size is back.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "What do the Japanese words on the tees mean?",
            "answer": "<p>Every design comes with its meaning on the product page, for example 浪人 Rōnin, the masterless warrior, or 義 Gi, rectitude. All Japanese text is checked by a native speaker before printing.</p>"
          }
        }
      },
      "block_order": [
