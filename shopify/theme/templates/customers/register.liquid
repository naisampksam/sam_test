<section class="page-width page-width--narrow section account">
  <h1 class="page-title">{{ 'customer.create_account' | t }}</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {{ form.errors | default_errors }}
    <label class="field">
      <span class="field__label">{{ 'customer.first_name' | t }}</span>
      <input type="text" name="customer[first_name]" class="field__input" autocomplete="given-name">
    </label>
    <label class="field">
      <span class="field__label">{{ 'customer.last_name' | t }}</span>
      <input type="text" name="customer[last_name]" class="field__input" autocomplete="family-name">
    </label>
    <label class="field">
      <span class="field__label">{{ 'customer.email' | t }}</span>
      <input type="email" name="customer[email]" class="field__input" autocomplete="email" required>
    </label>
    <label class="field">
      <span class="field__label">{{ 'customer.password' | t }}</span>
      <input type="password" name="customer[password]" class="field__input" autocomplete="new-password" required>
    </label>
    <button type="submit" class="button button--full">{{ 'customer.create' | t }}</button>
  {%- endform -%}
</section>
