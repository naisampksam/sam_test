{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    {{ content_for_header }}
    <style>
      body { font-family: system-ui, sans-serif; text-align: center; padding: 48px 16px; color: #111; background: #fff; }
      .code { font-size: 28px; letter-spacing: 2px; border: 2px dashed #111; display: inline-block; padding: 12px 24px; margin: 16px 0; }
      .button { display: inline-block; background: #111; color: #fff; padding: 14px 28px; text-decoration: none; text-transform: uppercase; letter-spacing: 1px; }
    </style>
  </head>
  <body>
    <h1>{{ shop.name }}</h1>
    {%- assign initial_value = gift_card.initial_value | money -%}
    <p>{{ 'gift_card.value' | t: value: initial_value }}</p>
    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p>{{ 'gift_card.expired' | t }}</p>
    {%- endif -%}
    <div class="code">{{ gift_card.code | format_code }}</div>
    <p>{{ 'gift_card.balance' | t }}: {{ gift_card.balance | money }}</p>
    {%- if gift_card.pass_url -%}
      <p><a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Apple Wallet"></a></p>
    {%- endif -%}
    <p><a href="{{ shop.url }}" class="button">{{ 'gift_card.shop' | t }}</a></p>
  </body>
</html>
