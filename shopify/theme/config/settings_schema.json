[
  {
    "name": "theme_info",
    "theme_name": "HAIKUFIT",
    "theme_version": "1.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#F3EFE6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (announcement bar, highlights)",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale badge / discount",
        "default": "#C8102E"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#F3EFE6"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold accent",
        "default": "#B08D57"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "brand_fonts",
        "label": "Use HAIKUFIT brand fonts",
        "info": "Oswald for headings and Shippori Mincho for Japanese text (Google Fonts). Turn off to use the font pickers below.",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Headings",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "assistant_n4"
      },
      {
        "type": "text",
        "id": "kanji_font",
        "label": "Japanese text font (Google Fonts name)",
        "default": "Shippori Mincho B1"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "paper_texture",
        "label": "Rice-paper texture background",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "brand_motifs",
        "label": "Japanese motifs (brush dividers, seal badges, wave patterns)",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32px .png recommended"
      }
    ]
  },
  {
    "name": "Battle animations",
    "settings": [
      {
        "type": "paragraph",
        "content": "Samurai-themed motion across the store. Automatically switched off for visitors who ask their device for reduced motion."
      },
      {
        "type": "checkbox",
        "id": "war_fx",
        "label": "Enable battle animations",
        "info": "Scroll reveals, brush-stroke headings, katana sheen on buttons and slash effect on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "intro_slash",
        "label": "Katana-slash intro",
        "info": "Plays once per visit when the store first opens",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "fx_petals",
        "label": "Falling sakura petals and embers",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "fx_scrollbar",
        "label": "Red katana scroll-progress line",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_sale_badge",
        "label": "Show sale % badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show color swatches",
        "default": true
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          {
            "value": "portrait",
            "label": "Portrait (2:3)"
          },
          {
            "value": "tall",
            "label": "Tall (3:4)"
          },
          {
            "value": "square",
            "label": "Square"
          }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_kanji",
        "label": "Show kanji seal on cards (from the design story)",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "After adding to cart",
        "options": [
          {
            "value": "drawer",
            "label": "Open cart drawer"
          },
          {
            "value": "page",
            "label": "Go to the cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (in store currency). Leave empty when every order ships free"
      },
      {
        "type": "product_list",
        "id": "cart_upsell_products",
        "label": "Cart upsell products",
        "info": "Shown in the cart drawer and cart page. Leave empty to use recommendations.",
        "limit": 4
      }
    ]
  },
  {
    "name": "Offers & conversion",
    "settings": [
      {
        "type": "header",
        "content": "Bundle offer (quantity tiers)"
      },
      {
        "type": "paragraph",
        "content": "The theme only DISPLAYS these offers. Create matching Automatic discounts in Shopify admin (Discounts → Create → Amount off products, minimum quantity) so the discount is actually applied."
      },
      {
        "type": "checkbox",
        "id": "offer_enable",
        "label": "Show bundle offer",
        "default": true
      },
      {
        "type": "text",
        "id": "offer_heading",
        "label": "Heading",
        "default": "Bundle & Save"
      },
      {
        "type": "range",
        "id": "tier1_qty",
        "label": "Tier 1: quantity",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 2
      },
      {
        "type": "range",
        "id": "tier1_discount",
        "label": "Tier 1: % off",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 10
      },
      {
        "type": "range",
        "id": "tier2_qty",
        "label": "Tier 2: quantity",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "tier2_discount",
        "label": "Tier 2: % off",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 15
      },
      {
        "type": "range",
        "id": "tier3_qty",
        "label": "Tier 3: quantity (0 = off)",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 5
      },
      {
        "type": "range",
        "id": "tier3_discount",
        "label": "Tier 3: % off",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 20
      },
      {
        "type": "text",
        "id": "offer_note",
        "label": "Note",
        "default": "Mix & match any tees. Discount applied automatically at checkout."
      },
      {
        "type": "header",
        "content": "Coupon codes"
      },
      {
        "type": "textarea",
        "id": "coupon_codes",
        "label": "Coupons (one per line: CODE | description)",
        "info": "Create each code in Shopify admin → Discounts.",
        "default": "WELCOME10 | Extra 10% off your first order\nPREPAID50 | Flat ₹50 off on prepaid orders"
      },
      {
        "type": "header",
        "content": "Sale countdown"
      },
      {
        "type": "text",
        "id": "sale_end",
        "label": "Sale ends at",
        "info": "Format: 2026-10-31T23:59:00+05:30. Countdowns hide automatically after this time. Only use a real end date.",
        "default": "2026-10-31T23:59:00+05:30"
      },
      {
        "type": "text",
        "id": "sale_label",
        "label": "Sale label",
        "default": "Festive Sale ends in"
      },
      {
        "type": "header",
        "content": "Delivery estimate"
      },
      {
        "type": "checkbox",
        "id": "delivery_enable",
        "label": "Show estimated delivery date",
        "default": true
      },
      {
        "type": "range",
        "id": "delivery_min_days",
        "label": "Minimum business days",
        "min": 1,
        "max": 15,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "delivery_max_days",
        "label": "Maximum business days",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 6
      },
      {
        "type": "range",
        "id": "dispatch_cutoff_hour",
        "label": "Same-day dispatch cutoff (24h clock)",
        "min": 8,
        "max": 23,
        "step": 1,
        "default": 14
      },
      {
        "type": "header",
        "content": "Stock"
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Show 'Only X left' when stock is at or below",
        "info": "Only works for products with inventory tracking turned on.",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 5
      },
      {
        "type": "header",
        "content": "Sign-up popup"
      },
      {
        "type": "checkbox",
        "id": "popup_enable",
        "label": "Show sign-up popup",
        "default": true
      },
      {
        "type": "range",
        "id": "popup_delay",
        "label": "Show after",
        "min": 3,
        "max": 60,
        "step": 1,
        "unit": "s",
        "default": 8
      },
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "popup_heading",
        "label": "Heading",
        "default": "Get 10% OFF your first order"
      },
      {
        "type": "text",
        "id": "popup_text",
        "label": "Text",
        "default": "Join the club for early access to drops and members-only offers."
      },
      {
        "type": "text",
        "id": "popup_code",
        "label": "Code shown after sign-up",
        "default": "WELCOME10"
      },
      {
        "type": "header",
        "content": "Product cards"
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_offer",
        "label": "Show bundle offer line on cards",
        "default": true
      }
    ]
  },
  {
    "name": "Store credit",
    "settings": [
      {
        "type": "paragraph",
        "content": "Customers earn store credit on each order (added by Shopify Flow after delivery, see STORE-CREDIT.md), see their balance when signed in, and spend it in the cart with one tap. Keep the numbers here the same as your Flow workflow."
      },
      {
        "type": "checkbox",
        "id": "credit_enable",
        "label": "Show store credit messages",
        "default": true
      },
      {
        "type": "select",
        "id": "credit_type",
        "label": "Credit per order",
        "options": [
          {
            "value": "fixed",
            "label": "Fixed amount"
          },
          {
            "value": "percent",
            "label": "Percentage of order"
          }
        ],
        "default": "percent"
      },
      {
        "type": "number",
        "id": "credit_amount",
        "label": "Fixed credit (₹)",
        "default": 100
      },
      {
        "type": "number",
        "id": "credit_percent",
        "label": "Percentage credit (%)",
        "default": 5
      },
      {
        "type": "number",
        "id": "credit_max",
        "label": "Maximum credit per order (₹, 0 = no limit)",
        "default": 100
      },
      {
        "type": "number",
        "id": "credit_min_order",
        "label": "Minimum order to earn credit (₹)",
        "default": 799
      },
      {
        "type": "number",
        "id": "credit_use_max",
        "label": "Maximum credit a customer can use per order (₹, 0 = no limit)",
        "default": 100,
        "info": "Keep the same as MAX_CREDIT_USE in the Cloudflare worker."
      },
      {
        "type": "text",
        "id": "credit_earn_text",
        "label": "Earn message",
        "info": "[amount] is replaced with the credit",
        "default": "Earn [amount] store credit"
      },
      {
        "type": "text",
        "id": "credit_use_text",
        "label": "How-to-use text (shown when hovering the ⓘ)",
        "default": "Added 10 days after delivery, valid 60 days."
      },
      {
        "type": "text",
        "id": "credit_gap_text",
        "label": "Cart message below minimum",
        "info": "[gap] and [amount] are replaced",
        "default": "Add [gap] more to earn [amount] credit"
      },
      {
        "type": "text",
        "id": "credit_balance_text",
        "label": "Balance text in the cart",
        "default": "[amount] store credit"
      },
      {
        "type": "header",
        "content": "Use credit in the cart"
      },
      {
        "type": "text",
        "id": "credit_secret",
        "label": "Store credit secret",
        "info": "Turns on the \"Use my credit\" button in the cart (works with any checkout, including Cashfree). Paste the same text as CREDIT_SECRET in your Cloudflare rewards worker. Uses the Rewards server URL from Dojo Run rewards. Keep it private."
      }
    ]
  },
  {
    "name": "Swatches",
    "settings": [
      {
        "type": "textarea",
        "id": "swatch_colors",
        "label": "Color swatches",
        "info": "One per line: Color name: hex. Used for the color option on products.",
        "default": "Black: #111111\nWhite: #FFFFFF\nBeige: #E8DCC6\nBottle Green: #0F4D2C\nChocolate: #5A3A26\nLavender: #C3A6E8\nNavy: #1B2340\nRoyal Blue: #1E3FD0\nRed: #D7261E"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X / Twitter URL"
      },
      {
        "type": "header",
        "content": "WhatsApp button"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number (with country code, e.g. 919876543210)",
        "info": "Leave empty to hide the floating WhatsApp button",
        "default": "918089963691"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "Pre-filled message",
        "default": "Hi! I have a question about your products."
      }
    ]
  },
  {
    "name": "Dojo Run rewards",
    "settings": [
      {
        "type": "paragraph",
        "content": "Give every Dojo Run winner a unique, single-use Shopify discount code that expires, instead of fixed codes anyone could share. Set up the free rewards server first (dojo-rewards/README.md in the theme download)."
      },
      {
        "type": "text",
        "id": "dojo_reward_api",
        "label": "Rewards server URL",
        "info": "Paste the full address starting with https://, e.g. https://dojo-rewards.your-name.workers.dev (nothing after .workers.dev). Leave empty to use the fixed codes set in the Dojo Run game section."
      }
    ]
  }
]
